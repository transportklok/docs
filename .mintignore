# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md
# Every other file is published, also a page outside the navigation.

# Authoring instructions, tooling and its data: never published
AGENTS.md
scripts/
.workspaces/
.atlas-analysis.json
.release-line-only
mobile-gps-tracker-concept.md
images/captures/*.json
coverage/

# Repository configuration
.gitignore
.mintignore

# Draft content
drafts/
*.draft.mdx

# Test fixtures, each a Mintlify project of its own
fixtures/

# Tests of the docs tooling
tests/

# Translation tooling state
.translations/
